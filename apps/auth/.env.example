DATABASE_URL="postgres://nestjs:nestjs@localhost:5432/nestjs?schema=public"
PORT="3000"
BETTER_AUTH_SECRET="some-random-secret-key"

# Split-subdomain topology (design.md → D1, nginx-subdomain-topology spec):
# auth lives on its own sibling subdomain, sharing a registrable parent
# domain with the frontend so the session cookie can be widened across both.
#
# BETTER_AUTH_URL must be the PUBLIC https origin — the Secure cookie prefix
# is derived from this value (or advanced.useSecureCookies), never from
# X-Forwarded-Proto, so a plain-http or container-internal value here
# silently drops the Secure prefix even behind a TLS-terminating proxy.
BETTER_AUTH_URL="https://auth.example.com/api/auth"

REDIS_HOST="localhost"
REDIS_PORT="6379"

MONGO_URI="mongodb://nestjs:nestjs@localhost:27017/nestjs?authSource=admin"

# The browser-facing origins allowed to call this service — also becomes
# `trustedOrigins` (see apps/auth/src/app.module.ts). Never a bare `*`: it
# would be filtered out and leave every origin untrusted.
CORS_ORIGIN="https://admin.example.com"

# Narrowest parent domain shared by the frontend and this service — enables
# `crossSubDomainCookies` so signing in on one sibling authenticates the
# others (SSO). Every sibling under it can read the session cookie, so
# nothing untrusted may be hosted there. Leave unset for a single-origin
# deployment with no SSO requirement (Domain then defaults to host-only).
COOKIE_DOMAIN=".example.com"

ADMIN_EMAIL="admin@admin.com"
ADMIN_PASSWORD="Admin123!"

METRICS_TOKEN=
# SENTRY_DSN=""
# SENTRY_TRACES_SAMPLE_RATE="0"