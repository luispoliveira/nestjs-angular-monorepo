DATABASE_URL="postgres://nestjs:nestjs@localhost:5432/nestjs?schema=public"
PORT="3300"

REDIS_HOST="localhost"
REDIS_PORT="6379"

MONGO_URI="mongodb://nestjs:nestjs@localhost:27017/nestjs?authSource=admin"

# Mail provider: "brevo" (default) or "resend". Only the active one's key is required.
MAIL_PROVIDER="brevo"
BREVO_API_KEY="key"
# RESEND_API_KEY="re_..."
# Web push (VAPID). Generate a pair with: npx web-push generate-vapid-keys
# The subject must be a mailto: or https: URL. Keep the private key secret;
# only the public key is also set in apps/api.
VAPID_SUBJECT="mailto:ops@example.com"
VAPID_PUBLIC_KEY="public-key"
VAPID_PRIVATE_KEY="private-key"

FROM_EMAIL="email"
FROM_NAME="name"
DEV_EMAIL="email"

CORS_ORIGIN="http://localhost:3000,*"

# Sentry (optional): leave SENTRY_DSN unset to disable.
# SENTRY_DSN=""
# Traces sample rate 0..1 — 0 disables tracing; e.g. 0.1 in production.
# SENTRY_TRACES_SAMPLE_RATE="0"
METRICS_TOKEN=