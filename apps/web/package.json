    "@angular/router": "^22.1.0",
    "@repo/shared-types": "workspace:*",
    "@tanstack/angular-query-experimental": "5.102.5",
    "better-auth": "^1.6.23",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
