{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "concurrency": "15",
  "tasks": {
    "build": {
      "dependsOn": ["db:generate", "^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "lint": {
      "dependsOn": ["db:generate", "^build", "^db:generate", "^lint"]
    },
    "test": {
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_HOST",
        "MONGO_URI",
        "CORS_ORIGIN",
        "FIELD_ENCRYPTION_KEY",
        "FIELD_ENCRYPTION_HMAC_KEY",
        "VAPID_PUBLIC_KEY"
      ],
      "dependsOn": ["^build"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:cov": {
      "dependsOn": ["^build"]
    },
    "check-types": {
      "dependsOn": ["db:generate", "^build", "^db:generate", "^check-types"]
    },
    "db:generate": {
      "dependsOn": ["^db:generate"]
    },
    "db:migrate": {
      "dependsOn": ["^db:migrate"]
    },
    "db:seed": {
      "dependsOn": ["^db:seed"]
    },
    "db:push": {
      "dependsOn": ["^db:push"]
    }
  }
}
