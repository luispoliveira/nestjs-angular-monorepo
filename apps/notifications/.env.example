DATABASE_URL="postgres://nestjs:nestjs@localhost:5432/nestjs?schema=public"
PORT="3200"

REDIS_HOST="localhost"
REDIS_PORT="6379"

MONGO_URI="mongodb://nestjs:nestjs@localhost:27017/nestjs?authSource=admin"

CORS_ORIGIN="http://localhost:3000,*"

# Sentry (optional): leave SENTRY_DSN unset to disable.
# SENTRY_DSN=""
# Traces sample rate 0..1 — 0 disables tracing; e.g. 0.1 in production.
# SENTRY_TRACES_SAMPLE_RATE="0"

# Prometheus metrics bearer token (optional).
# Leave empty for open access (local dev, private network scraping).
# Set to a random secret in production; Prometheus scrape_config supports
# authorization.credentials to pass this token automatically.
METRICS_TOKEN=
